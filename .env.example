# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter API Key for LLM (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Database
DATABASE_URL=sqlite:///data/messages.db

# Web Server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE_MINUTES=1440

# Superadmin Credentials
# Generate password hash with: python -c "from app.web.auth import hash_password; print(hash_password('your_password'))"
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD_HASH='$2b$12$your_generated_hash_here'

# Telegram Bot Username (for Login Widget, without @)
TELEGRAM_BOT_USERNAME=your_bot_username

# Bot Settings
CONTEXT_MESSAGES=25
SUMMARY_TIME_LOCAL=16:00
SUMMARY_TIMEZONE=Europe/Moscow

# Logging
LOG_LEVEL=INFO
