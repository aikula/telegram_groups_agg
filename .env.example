# ==============================================================================
# Telegram Chat Analytics Bot - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bot username (without @) - used for Telegram Login Widget
TELEGRAM_BOT_USERNAME=your_bot_username

# Optional: Webhook URL for production deployment
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com/webhook/telegram

# ------------------------------------------------------------------------------
# LLM Configuration (OpenAI-compatible API)
# ------------------------------------------------------------------------------
# OpenRouter API Key - get it at https://openrouter.ai/
LLM_API_KEY=your_openrouter_api_key_here

# LLM Model Name
LLM_MODEL_NAME=anthropic/claude-3.5-sonnet

# Optional: Override default OpenRouter API URL
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: LLM parameters with sensible defaults
# LLM_MAX_TOKENS=4000
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=60

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# AES-256 Encryption Master Key (Base64-encoded 32 bytes)
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=your_encryption_master_key_here

# JWT Secret Key for web authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# Optional: JWT parameters with defaults
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Admin Account
# ------------------------------------------------------------------------------
# Superadmin username for web interface
SUPERADMIN_USERNAME=admin

# Superadmin password hash (bcrypt)
# Generate with: python -c "from app.web.auth import hash_password; print(hash_password('YOUR_PASSWORD'))"
SUPERADMIN_PASSWORD_HASH=$2b$12$your_generated_hash_here

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Database URL (SQLite with aiosqlite driver)
DATABASE_URL=sqlite+aiosqlite:///./data/chat_data.db

# Optional: Override database path
# DATABASE_PATH=data/chat_data.db

# ------------------------------------------------------------------------------
# Features
# ------------------------------------------------------------------------------
# Optional: Feature configuration with defaults
# RETENTION_DAYS=90
# SUMMARY_TIME_UTC=13:00
# DEFAULT_LANGUAGE=ru
# CONTEXT_MESSAGES=20

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
# Optional: Rate limiting with defaults
# TELEGRAM_GLOBAL_RATE=30
# TELEGRAM_PER_CHAT_RATE=1.0
# API_RATE_LIMIT=10/minute

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Optional: Server configuration with defaults
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# Base URL for OTP login messages
BASE_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Optional: Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
