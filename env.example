# =============================================================================
# TELEGRAM CHAT ANALYTICS BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Версия: 2.0
# Дата: 2026-01-28
#
# ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл как .env
#    cp .env.example .env
#
# 2. Заполните все значения (замените примеры на реальные)
#
# 3. Добавьте .env в .gitignore (КРИТИЧНО!)
#    echo ".env" >> .gitignore
#
# 4. НИКОГДА не коммитьте .env с реальными секретами
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ОСНОВНЫЕ НАСТРОЙКИ
# -----------------------------------------------------------------------------

# Режим работы: development, production
ENVIRONMENT=development

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Таймзона для scheduled jobs
TIMEZONE=Europe/Moscow

# -----------------------------------------------------------------------------
# 2. TELEGRAM BOT
# -----------------------------------------------------------------------------

# Токен бота (получить у @BotFather)
# Пример: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-123456789
TELEGRAM_BOT_TOKEN=

# Webhook URL (если используете webhook вместо polling)
# Оставьте пустым для polling режима
# Пример: https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_URL=

# Webhook секрет (опционально, для верификации)
TELEGRAM_WEBHOOK_SECRET=

# Admin telegram_id (для отладочных сообщений)
# Ваш личный Telegram ID (узнать у @userinfobot)
TELEGRAM_ADMIN_ID=

# -----------------------------------------------------------------------------
# 3. ШИФРОВАНИЕ
# -----------------------------------------------------------------------------

# Мастер-ключ для шифрования сообщений (32 байта, base64)
# ГЕНЕРАЦИЯ:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# КРИТИЧНО: 
# - Сгенерируйте ОДИН РАЗ
# - Сохраните backup в защищенном месте (1Password, Vault)
# - При утере НЕВОЗМОЖНО расшифровать данные
#
# Пример: hN6p3RlK4Qm9Xw2Yv8Zt5Bf7Cg1Dj0Ek6Lh3Mn4Op2Qr==
MASTER_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 4. JWT AUTHENTICATION (для Web UI)
# -----------------------------------------------------------------------------

# Секретный ключ для JWT токенов
# ГЕНЕРАЦИЯ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Пример: 9vK2xL5mN8qR1tY4wZ7bC0dF3gH6jK9lM2nP5rS8uV1xY4zA7bD0eF3gH6jK9lM2
JWT_SECRET_KEY=

# Алгоритм JWT (не менять без необходимости)
JWT_ALGORITHM=HS256

# Срок действия access token (в днях)
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 5. DATABASE
# -----------------------------------------------------------------------------

# Путь к SQLite базе данных
DATABASE_PATH=data/chat_data.db

# Для production можно использовать PostgreSQL (roadmap v2.2):
# DATABASE_URL=postgresql://user:password@localhost:5432/telegram_bot

# Timeout для SQL запросов (миллисекунды)
DATABASE_QUERY_TIMEOUT=5000

# -----------------------------------------------------------------------------
# 6. REDIS (для кэширования и rate limiting)
# -----------------------------------------------------------------------------

# Redis connection URL
# Локально: redis://localhost:6379/0
# Docker: redis://redis:6379/0
# С паролем: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis timeout (секунды)
REDIS_TIMEOUT=5

# TTL для кэша (секунды)
REDIS_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# 7. LLM API (DeepSeek)
# -----------------------------------------------------------------------------

# DeepSeek API ключ
# Получить: https://platform.deepseek.com/api_keys
# Пример: sk-1234567890abcdef1234567890abcdef
DEEPSEEK_API_KEY=

# DeepSeek base URL (обычно не нужно менять)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель по умолчанию
DEEPSEEK_MODEL=deepseek-chat

# Timeout для LLM запросов (секунды)
LLM_TIMEOUT=30

# Максимум токенов в ответе
LLM_MAX_TOKENS=4000

# Temperature (0.0-2.0)
LLM_TEMPERATURE=0.7

# Retry attempts при ошибках API
LLM_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# 8. WEB API
# -----------------------------------------------------------------------------

# Host для FastAPI (0.0.0.0 - все интерфейсы, 127.0.0.1 - только локально)
WEB_HOST=0.0.0.0

# Port для FastAPI
WEB_PORT=8000

# CORS allowed origins (через запятую)
# Development: http://localhost:3000
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Reload при изменениях (только для development!)
WEB_RELOAD=true

# -----------------------------------------------------------------------------
# 9. RATE LIMITING
# -----------------------------------------------------------------------------

# Rate limit для OTP запросов (запросов в минуту)
RATE_LIMIT_OTP_PER_MINUTE=3

# Rate limit для API (запросов в минуту на пользователя)
RATE_LIMIT_API_PER_MINUTE=100

# Rate limit для Summary (запросов в час)
RATE_LIMIT_SUMMARY_PER_HOUR=10

# Rate limit для Export (запросов в час)
RATE_LIMIT_EXPORT_PER_HOUR=5

# -----------------------------------------------------------------------------
# 10. DATA RETENTION
# -----------------------------------------------------------------------------

# Срок хранения сообщений (дни)
# По умолчанию: 90 дней
RETENTION_DAYS=90

# Срок хранения audit log (дни)
# По умолчанию: 365 дней
AUDIT_LOG_RETENTION_DAYS=365

# Автоматическая очистка старых данных (true/false)
AUTO_CLEANUP_ENABLED=true

# Время очистки (формат cron: час минута)
CLEANUP_TIME=03:00

# -----------------------------------------------------------------------------
# 11. SCHEDULED JOBS
# -----------------------------------------------------------------------------

# Включить scheduled jobs (true/false)
SCHEDULER_ENABLED=true

# Время ежедневной сводки по умолчанию (HH:MM)
DEFAULT_SUMMARY_TIME=16:00

# Дней для сводки по умолчанию
DEFAULT_SUMMARY_DAYS=7

# -----------------------------------------------------------------------------
# 12. FEATURES FLAGS
# -----------------------------------------------------------------------------

# Включить Skills
SKILL_SUMMARY_ENABLED=true
SKILL_COACH_ENABLED=true
SKILL_QA_ENABLED=true
SKILL_ANALYTICS_ENABLED=true

# Включить web интерфейс
WEB_UI_ENABLED=true

# Включить metrics экспорт (Prometheus)
METRICS_ENABLED=false
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# 13. BACKUP
# -----------------------------------------------------------------------------

# Путь для backup файлов
BACKUP_PATH=backups/

# Автоматический backup (true/false)
AUTO_BACKUP_ENABLED=true

# Время backup (формат cron: час минута)
BACKUP_TIME=02:00

# Срок хранения backup (дни)
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 14. MONITORING & ALERTS
# -----------------------------------------------------------------------------

# Sentry DSN для error tracking (опционально)
# Получить: https://sentry.io
# Пример: https://abc123@o123456.ingest.sentry.io/123456
SENTRY_DSN=

# Webhook для alerts (Slack, Discord, Telegram channel)
ALERT_WEBHOOK_URL=

# Минимальный уровень для alerts (ERROR, CRITICAL)
ALERT_MIN_LEVEL=ERROR

# -----------------------------------------------------------------------------
# 15. DEVELOPMENT & DEBUG
# -----------------------------------------------------------------------------

# Режим отладки (true только для development!)
DEBUG=false

# Профилирование запросов (true для анализа производительности)
PROFILING_ENABLED=false

# Mock LLM для тестов (true - не делать реальные API вызовы)
MOCK_LLM=false

# Verbose SQL logging (true - логировать все SQL запросы)
SQL_ECHO=false

# -----------------------------------------------------------------------------
# 16. DOCKER (если используете)
# -----------------------------------------------------------------------------

# Docker compose project name
COMPOSE_PROJECT_NAME=telegram-bot

# Docker network name
DOCKER_NETWORK=telegram-bot-network

# -----------------------------------------------------------------------------
# 17. SECURITY
# -----------------------------------------------------------------------------

# OTP длина (цифр)
OTP_LENGTH=6

# OTP TTL (секунды)
OTP_TTL=300

# OTP максимум попыток
OTP_MAX_ATTEMPTS=3

# Требовать HTTPS для webhook (production: true)
REQUIRE_HTTPS=false

# Allowed IP addresses для admin endpoints (через запятую)
# Пустое значение = любые IP
# Пример: 192.168.1.0/24,10.0.0.1
ADMIN_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# КОНЕЦ КОНФИГУРАЦИИ
# -----------------------------------------------------------------------------

# ПРИМЕЧАНИЯ:
#
# 1. Обязательные переменные (без них бот не запустится):
#    - TELEGRAM_BOT_TOKEN
#    - MASTER_ENCRYPTION_KEY
#    - JWT_SECRET_KEY
#    - DEEPSEEK_API_KEY
#
# 2. Рекомендуемые для production:
#    - SENTRY_DSN (мониторинг ошибок)
#    - ALERT_WEBHOOK_URL (уведомления)
#    - TELEGRAM_ADMIN_ID (отладка)
#
# 3. Генерация секретных ключей:
#
#    # Encryption key
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#    # JWT secret
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#    # Random secret
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 4. Проверка конфигурации:
#    python -m app.core.config --validate
#
# 5. Backup .env файла:
#    Регулярно делайте backup .env в защищенное место (НЕ в Git!)
#
# =============================================================================
